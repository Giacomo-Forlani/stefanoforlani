---
interface Props {
  id: string;
  kicker: string;
  title: string;
  lead?: string;
  intro?: string;
  centered?: boolean;
  tone?: 'light' | 'dark';
}

const { id, kicker, title, lead, intro, centered = false, tone = 'light' } = Astro.props;
---

<header class:list={['heading', 'reveal', { centered }, tone]}>
  <p class="kicker">{kicker}</p>
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
  {intro && <p class="intro">{intro}</p>}
</header>

<style>
  .heading {
    max-width: 760px;
    margin-bottom: 68px;
  }

  h2 {
    margin-bottom: 15px;
  }

  .intro {
    margin-bottom: 0;
    color: var(--muted);
  }

  .dark .intro {
    color: var(--on-ink-muted);
  }

  .lead {
    margin-bottom: 8px;
    font-family: var(--serif);
    font-size: 1.7rem;
    line-height: 1.3;
  }

  .centered {
    margin-inline: auto;
    text-align: center;
  }

  .centered .kicker {
    justify-content: center;
  }

  @media (max-width: 700px) {
    .heading {
      margin-bottom: 48px;
    }
  }
</style>
