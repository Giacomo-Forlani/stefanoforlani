---
import { Image } from 'astro:assets';
import portrait from '../assets/ste.jpg';
import { hero } from '../data/site';
---

<section class="hero" id="inizio" aria-labelledby="hero-title">
  <div class="shell grid">
    <div class="copy reveal">
      <h1 id="hero-title">
        <span class="sr-only">{hero.kicker}: </span>
        <span class="title">
          {hero.titleLines.map((line, i) => (
            <>{i > 0 && ' '}<span class="line">{line}</span></>
          ))}
        </span>
      </h1>
    </div>

    <p class="subtitle reveal" style="--delay: 80ms">{hero.subtitle}</p>

    <figure class="photo reveal" style="--delay: 100ms">
      <div class="photo-stage">
        <div class="frame">
          <Image
            src={portrait}
            alt={hero.photoAlt}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </figure>

    <div class="actions reveal" style="--delay: 150ms">
      <a class="button button--primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
      <a class="button button--secondary" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: min(840px, 100svh);
    padding: calc(var(--header-h) + 62px) 0 80px;
    overflow: hidden;
    background: var(--paper);
  }

  /* Fondo editoriale a due toni, senza cornici ad arco. */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 0 0 45%;
    background: linear-gradient(160deg, var(--sage-2), #e9eee6);
  }

  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    column-gap: clamp(40px, 5.5vw, 86px);
    row-gap: 0;
    align-items: center;
  }

  .copy {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    min-width: 0;
    padding-top: 12px;
  }

  .copy::before {
    content: '';
    display: block;
    width: 56px;
    height: 2px;
    margin-bottom: 32px;
    background: var(--copper);
  }

  /* Il nome è già nella navigazione; nell'H1 rimane disponibile agli screen reader. */
  h1 {
    max-width: 670px;
    margin-bottom: 20px;
  }

  .title {
    display: block;
    font-size: clamp(3.6rem, 6.5vw, 7rem);
    line-height: 0.99;
    letter-spacing: -0.045em;
  }

  .title .line {
    display: block;
    white-space: nowrap;
  }

  .subtitle {
    grid-column: 1;
    grid-row: 2;
    margin-bottom: 0;
    color: var(--copper);
    font-family: var(--serif);
    font-size: clamp(1.9rem, 3vw, 3.5rem);
    font-style: italic;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .actions {
    grid-column: 1;
    grid-row: 3;
    align-self: start;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .photo {
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: center;
    min-width: 0;
    margin: 0;
  }

  /* Rettangolo sfalsato: mantiene profondità senza l'effetto "lapide". */
  .photo-stage {
    position: relative;
    padding: 0 28px 28px 0;
  }

  .photo-stage::before {
    content: '';
    position: absolute;
    inset: 44px 0 0 52px;
    background: #b8cbbd;
    border-radius: 12px;
  }

  .frame {
    position: relative;
    z-index: 1;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    background: var(--sage);
    box-shadow: 0 22px 58px rgba(23, 53, 47, 0.14);
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: saturate(0.9);
  }

  @media (max-width: 1000px) {
    .hero {
      min-height: 0;
    }

    .grid {
      gap: 34px;
    }

    .title {
      font-size: clamp(3.25rem, 7.2vw, 5.8rem);
    }

    .photo-stage {
      padding: 0 20px 20px 0;
    }

    .photo-stage::before {
      inset: 35px 0 0 40px;
    }
  }

  @media (max-width: 700px) {
    .hero {
      padding: calc(var(--header-h) + 30px) 0 68px;
    }

    .hero::before {
      inset: auto 0 0;
      height: 38%;
    }

    /* Come nella composizione originale: foto piccola nella fascia del titolo,
       a destra e dietro alla tipografia, non in una riga separata. */
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .copy {
      grid-column: 1;
      grid-row: 1;
      align-self: stretch;
      position: relative;
      z-index: 2;
      padding: 0;
      pointer-events: none;
    }

    .copy::before {
      margin-bottom: 25px;
    }

    h1 {
      margin-bottom: 15px;
    }

    .title {
      font-size: clamp(2.9rem, 12vw, 4.7rem);
    }

    .subtitle {
      grid-column: 1;
      grid-row: 2;
      position: relative;
      z-index: 2;
      font-size: clamp(1.9rem, 7.4vw, 2.6rem);
    }

    .actions {
      grid-column: 1;
      grid-row: 3;
      flex-direction: column;
      gap: 11px;
      margin-top: 28px;
    }

    .photo {
      grid-column: 1;
      grid-row: 1;
      z-index: 1;
      width: min(38%, 150px);
      justify-self: end;
      align-self: end;
      margin: 0 -9px 14px 0;
    }

    .photo-stage {
      padding: 0 9px 9px 0;
    }

    .photo-stage::before {
      inset: 16px 0 0 16px;
      border-radius: 10px;
    }

    .frame {
      aspect-ratio: 1 / 1;
      border-radius: 10px;
    }

    /* Il titolo è sempre sopra il ritratto, anche nelle sovrapposizioni minime. */
    .title {
      text-shadow: 0 0 8px var(--paper), 0 0 18px rgba(247, 244, 237, 0.8);
    }
  }

  @media (max-width: 380px) {
    .title {
      font-size: clamp(2.75rem, 11.4vw, 3.3rem);
    }
  }
</style>
